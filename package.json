{
  "name": "eqmonitor-site",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.14.0",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "portless eqmonitor-site vp dev .",
    "build": "vp build .",
    "preview": "portless eqmonitor-site vp preview .",
    "prepare": "svelte-kit sync || true",
    "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:well-known": "node scripts/check-well-known.mjs",
    "lint": "vp lint",
    "deploy": "vp build . && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply eqmonitor-site-inquiries --local",
    "db:migrate:remote": "wrangler d1 migrations apply eqmonitor-site-inquiries --remote"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.6.0",
    "bits-ui": "^2.22.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "daisyui": "^5.8.1",
    "portless": "^0.18.0",
    "svelte": "^5.59.0",
    "svelte-check": "^4.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "^1.8.0",
    "wrangler": "^4.164.0"
  }
}
