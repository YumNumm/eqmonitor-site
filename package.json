{
  "name": "eqmonitor-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "portless eqmonitor-site vp dev .",
    "build": "vp build .",
    "preview": "portless eqmonitor-site vp preview .",
    "prepare": "svelte-kit sync || true",
    "check": "wrangler types && svelte-kit sync && node node_modules/typescript7/bin/tsc -p tsconfig.check.json --runExternalCode",
    "check:well-known": "node scripts/check-well-known.mjs",
    "lint": "vp lint",
    "format": "vp fmt",
    "deploy": "vp build . && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply eqmonitor-site-inquiries --local",
    "db:migrate:remote": "wrangler d1 migrations apply eqmonitor-site-inquiries --remote"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.3.0",
    "bits-ui": "^2.22.0",
    "gray-matter": "^4.0.3",
    "marked": "^16.4.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.3.0",
    "unified": "^11.0.5",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@eqmonitor-site/svelte-content-mapper": "workspace:*",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.5.4",
    "daisyui": "^5.5.19",
    "portless": "^0.13.1",
    "svelte": "^5.59.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript7": "npm:typescript@7.1.0-beta",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "^1.8.0",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@12.22.0"
}
